# Usa uma imagem leve do Python
FROM python:3.9-slim

# Define o diretório de trabalho
WORKDIR /app

# Copia os arquivos de dependências e instala
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia a aplicação como pacote para compartilhar os mesmos imports localmente e no contêiner
COPY __init__.py ./backend/__init__.py
COPY app.py ./backend/app.py
COPY lexer.py ./backend/lexer.py

# Expõe a porta que o Flask vai rodar
EXPOSE 5000

# Comando para iniciar o servidor
CMD ["python", "-m", "backend.app"]